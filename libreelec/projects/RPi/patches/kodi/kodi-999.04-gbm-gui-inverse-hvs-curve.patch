@@ -63,6 +63,7 @@ void CGuiCompositeShaderGLES::OnCompiledAndLinked()
   m_hLutTF = glGetUniformLocation(ProgramHandle(), "u_lutTF");
   m_hProj = glGetUniformLocation(ProgramHandle(), "u_proj");
   m_hOotfGamma = glGetUniformLocation(ProgramHandle(), "u_ootfGamma");
+  m_hHvsCurve = glGetUniformLocation(ProgramHandle(), "u_hvsCurve");
   glUseProgram(ProgramHandle());
   glUniform1i(m_hSamp, 0);
   glUniform1i(m_hLutDegamma, 1);
@@ -76,6 +77,7 @@ bool CGuiCompositeShaderGLES::OnEnabled()
     glUniformMatrix4fv(m_hProj, 1, GL_FALSE, m_proj);
 
   glUniform1f(m_hOotfGamma, m_ootfGamma);
+  glUniform1f(m_hHvsCurve, m_hvsCurve);
 
   glActiveTexture(GL_TEXTURE1);
   glBindTexture(GL_TEXTURE_2D, m_lutDegammaTexId);
@@ -171,6 +173,8 @@ bool CGuiCompositeShaderGLES::CreateLUTs(int colorTransfer)
   if (m_lutTFTexId)
     glDeleteTextures(1, &m_lutTFTexId);
 
+  m_hvsCurve = 0.0f;
+
   m_lutDegammaTexId = CreateLUTTexture(GenerateDegammaLUT());
   if (!m_lutDegammaTexId)
   {
@@ -205,3 +209,29 @@ bool CGuiCompositeShaderGLES::CreateLUTs(int colorTransfer)
   }
   return true;
 }
+
+bool CGuiCompositeShaderGLES::CreateCurveLUT(const std::vector<float>& inverseCurve)
+{
+  if (inverseCurve.empty())
+    return false;
+
+  if (m_lutDegammaTexId)
+    glDeleteTextures(1, &m_lutDegammaTexId);
+  if (m_lutTFTexId)
+    glDeleteTextures(1, &m_lutTFTexId);
+  m_lutDegammaTexId = 0;
+
+  m_lutTFTexId = CreateLUTTexture(inverseCurve);
+  if (!m_lutTFTexId)
+  {
+    CLog::Log(LOGERROR, "CGuiCompositeShaderGLES::CreateCurveLUT - failed to create LUT");
+    return false;
+  }
+
+  m_ootfGamma = 0.0f;
+  m_hvsCurve = 1.0f;
+  CLog::Log(LOGDEBUG, "CGuiCompositeShaderGLES::CreateCurveLUT - created inverse curve LUT ({} "
+                      "entries)",
+            inverseCurve.size());
+  return true;
+}
