           // Try single-pass filter shader for FAST scalers on GLES 3.1+
           if (m_renderQuality == RQ_SINGLEPASS &&
@@ -2221,7 +2221,7 @@ bool CLinuxRendererGLES::IsGuiLayer()
 void CLinuxRendererGLES::CheckVideoParameters(int index)
 {
   const CPictureBuffer& buf = m_buffers[index];
-  const ETONEMAPMETHOD& toneMapMethod = m_videoSettings.m_ToneMapMethod;
+  const ETONEMAPMETHOD toneMapMethod = ShaderToneMapMethod(m_videoSettings.m_ToneMapMethod);
 
   if (buf.m_srcPrimaries != m_srcPrimaries)
   {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
index bc5d23f..d893932 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
@@ -496,7 +496,7 @@ void CRendererBase::UpdateVideoFilters()
 void CRendererBase::CheckVideoParameters()
 {
   CRenderBuffer* buf = m_renderBuffers[m_iBufferIndex];
-  ETONEMAPMETHOD method = m_videoSettings.m_ToneMapMethod;
+  ETONEMAPMETHOD method = ShaderToneMapMethod(m_videoSettings.m_ToneMapMethod);
 
   bool isHDRPQ = (buf->color_transfer == AVCOL_TRC_SMPTE2084 && buf->primaries == AVCOL_PRI_BT2020);
 
diff --git a/xbmc/cores/VideoSettings.h b/xbmc/cores/VideoSettings.h
index 82779fb..c0c11bb 100644
--- a/xbmc/cores/VideoSettings.h
+++ b/xbmc/cores/VideoSettings.h
@@ -160,9 +160,16 @@ enum ETONEMAPMETHOD
   VS_TONEMAPMETHOD_REINHARD = 1,
   VS_TONEMAPMETHOD_ACES = 2,
   VS_TONEMAPMETHOD_HABLE = 3,
+  VS_TONEMAPMETHOD_BT2390 = 4,
   VS_TONEMAPMETHOD_MAX
 };
 
+//! BT.2390 is only done in hardware (DRM PRIME), shaders use Hable for it
+constexpr ETONEMAPMETHOD ShaderToneMapMethod(ETONEMAPMETHOD method)
+{
+  return method == VS_TONEMAPMETHOD_BT2390 ? VS_TONEMAPMETHOD_HABLE : method;
+}
+
 template<>
 struct fmt::formatter<ETONEMAPMETHOD> : fmt::formatter<std::string_view>
 {
@@ -189,6 +196,7 @@ private:
       {VS_TONEMAPMETHOD_REINHARD, "reinhard"},
       {VS_TONEMAPMETHOD_ACES, "aces"},
       {VS_TONEMAPMETHOD_HABLE, "hable"},
+      {VS_TONEMAPMETHOD_BT2390, "bt2390"},
   });
 
   static_assert(VS_TONEMAPMETHOD_MAX == tonemapMethodMap.size(),
diff --git a/xbmc/video/dialogs/GUIDialogVideoSettings.cpp b/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
index 4f42759..8f31ca6 100644
--- a/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
@@ -444,15 +444,29 @@ void CGUIDialogVideoSettings::InitializeSettings()
     const bool visible = !CServiceBroker::GetWinSystem()->IsHDRDisplaySettingEnabled();
     entries.clear();
     entries.emplace_back(36554, VS_TONEMAPMETHOD_OFF);
-    entries.emplace_back(36555, VS_TONEMAPMETHOD_REINHARD);
-    entries.emplace_back(36557, VS_TONEMAPMETHOD_ACES);
-    entries.emplace_back(36558, VS_TONEMAPMETHOD_HABLE);
-
-    AddSpinner(groupVideo, SETTING_VIDEO_TONEMAP_METHOD, 36553, SettingLevel::Basic,
-               videoSettings.m_ToneMapMethod, entries, false, visible);
-    AddSlider(groupVideo, SETTING_VIDEO_TONEMAP_PARAM, 36556, SettingLevel::Basic,
-              videoSettings.m_ToneMapParam, "{:2.2f}", 0.1f, 0.1f, 5.0f, 36556, usePopup, false,
-              visible);
+
+    if (appPlayer->Supports(RENDERFEATURE_TONEMAP_HW))
+    {
+      // any method other than off selects the hardware curve
+      entries.emplace_back(36559, VS_TONEMAPMETHOD_BT2390);
+      const int method = videoSettings.m_ToneMapMethod == VS_TONEMAPMETHOD_OFF
+                             ? VS_TONEMAPMETHOD_OFF
+                             : VS_TONEMAPMETHOD_BT2390;
+      AddSpinner(groupVideo, SETTING_VIDEO_TONEMAP_METHOD, 36553, SettingLevel::Basic, method,
+                 entries, false, visible);
+    }
+    else
+    {
+      entries.emplace_back(36555, VS_TONEMAPMETHOD_REINHARD);
+      entries.emplace_back(36557, VS_TONEMAPMETHOD_ACES);
+      entries.emplace_back(36558, VS_TONEMAPMETHOD_HABLE);
+
+      AddSpinner(groupVideo, SETTING_VIDEO_TONEMAP_METHOD, 36553, SettingLevel::Basic,
+                 videoSettings.m_ToneMapMethod, entries, false, visible);
+      AddSlider(groupVideo, SETTING_VIDEO_TONEMAP_PARAM, 36556, SettingLevel::Basic,
+                videoSettings.m_ToneMapParam, "{:2.2f}", 0.1f, 0.1f, 5.0f, 36556, usePopup, false,
+                visible);
+    }
   }
 
   // stereoscopic settings
