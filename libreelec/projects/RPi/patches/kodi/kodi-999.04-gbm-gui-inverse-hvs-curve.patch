+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.cpp
@@ -310,18 +310,18 @@ void CRendererDRMPRIME::ConfigureHDR()
   if (!winSystem)
     return;
 
-  const bool passthroughHDR = winSystem->SetHDR(&m_picture);
+  m_passthroughHDR = winSystem->SetHDR(&m_picture);
   CLog::Log(LOGDEBUG, "CRendererDRMPRIME::Configure: HDR passthrough: {}",
-            passthroughHDR ? "on" : "off");
+            m_passthroughHDR ? "on" : "off");
 
-  const bool hdrFboActive = passthroughHDR && winSystem->SetGuiCompositing(m_picture.color_transfer);
-  if (passthroughHDR && !hdrFboActive)
+  const bool hdrFboActive =
+      m_passthroughHDR && winSystem->SetGuiCompositing(m_picture.color_transfer);
+  if (m_passthroughHDR && !hdrFboActive)
     CLog::Log(LOGWARNING, "CRendererDRMPRIME::Configure: HDR passthrough active but "
                           "GUI compositing not supported by windowing system");
-  else if (!passthroughHDR && winSystem->IsHdrComposite())
-    winSystem->SetGuiCompositing(false);
 
-  m_pqWithoutHdr = !passthroughHDR && m_picture.color_transfer == AVCOL_TRC_SMPTE2084;
+  // UpdateToneMapping() sets up the GUI compositing without passthrough
+  m_pqWithoutHdr = !m_passthroughHDR && m_picture.color_transfer == AVCOL_TRC_SMPTE2084;
   m_colorimetrySet = false;
   UpdateToneMapping();
 }
@@ -330,11 +330,24 @@ void CRendererDRMPRIME::UpdateToneMapping()
 {
   auto* winSystem = static_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem());
 
-  const bool enable =
-      m_pqWithoutHdr && m_toneMappingAllowed && winSystem->SupportsHwToneMapping();
+  bool enable = m_pqWithoutHdr && m_toneMappingAllowed && winSystem->SupportsHwToneMapping();
   if (enable == m_hwToneMapping && m_colorimetrySet)
     return;
 
+  // keep the GUI as it is without the curve, and the curve off when the GUI
+  // cannot be composited through its inverse
+  if (!m_passthroughHDR)
+  {
+    const int transfer = enable ? CWinSystemGbm::GUI_COMPOSITE_HVS_CURVE : 0;
+    if (!winSystem->SetGuiCompositing(transfer) && enable)
+    {
+      CLog::Log(LOGWARNING,
+                "CRendererDRMPRIME: GUI compositing for the HVS curve not available, "
+                "tone mapping off");
+      enable = false;
+    }
+  }
+
   // the curve outputs BT.709
   winSystem->SetColorimetry(enable ? nullptr : &m_picture);
   m_colorimetrySet = true;
