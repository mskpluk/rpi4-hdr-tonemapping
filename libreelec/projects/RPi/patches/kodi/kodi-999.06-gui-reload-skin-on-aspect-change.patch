diff --git a/xbmc/application/ApplicationMessageHandling.cpp b/xbmc/application/ApplicationMessageHandling.cpp
index 27b733d..d51d87c 100644
--- a/xbmc/application/ApplicationMessageHandling.cpp
+++ b/xbmc/application/ApplicationMessageHandling.cpp
@@ -17,6 +17,7 @@
 #include "ServiceBroker.h"
 #include "ServiceManager.h"
 #include "Util.h"
+#include "addons/Skin.h"
 #include "application/AppInboundProtocol.h"
 #include "application/Application.h"
 #include "application/ApplicationEnums.h"
@@ -63,8 +64,10 @@
 #include "utils/FileExtensionProvider.h"
 #include "utils/URIUtils.h"
 #include "video/VideoFileItemClassify.h"
+#include "windowing/GraphicContext.h"
 #include "windowing/WinSystem.h"
 
