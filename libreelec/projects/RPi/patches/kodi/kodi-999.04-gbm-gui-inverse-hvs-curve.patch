 constexpr const char* HVS_PQ_CRTC = "/sys/module/vc4/parameters/hvs5_pq_crtc";
+constexpr const char* HVS_PQ_CURVE = "/sys/module/vc4/parameters/hvs5_pq_pwl";
+constexpr int HVS_PQ_CURVE_POINTS = 16;
 
 //! The kernel reports the CRTC getting the curve, 0 if it was not loaded
 bool HvsCurveAppliesTo(const CDRMCrtc* crtc)
@@ -719,3 +725,69 @@ void CWinSystemGbm::SetHwToneMapping(bool enable)
 
   CLog::LogF(LOGINFO, "HVS PQ tone mapping {}", enable ? "on" : "off");
 }
+
+std::vector<float> CWinSystemGbm::GetHwToneMappingInverse(int size)
+{
+  std::ifstream file(HVS_PQ_CURVE);
+  std::string text;
+  std::getline(file, text);
+
+  // pairs of words: x (31:20) | c (U12.4), gradient (U4.8)
+  const std::vector<std::string> words = StringUtils::Split(text, ',');
+  if (words.size() != HVS_PQ_CURVE_POINTS * 2)
+  {
+    CLog::LogF(LOGERROR, "unexpected curve in {}", HVS_PQ_CURVE);
+    return {};
+  }
+
+  struct Point
+  {
+    float x;
+    float c;
+    float grad;
+  };
+  std::array<Point, HVS_PQ_CURVE_POINTS> points;
+  for (int i = 0; i < HVS_PQ_CURVE_POINTS; i++)
+  {
+    uint32_t word[2];
+    for (int j = 0; j < 2; j++)
+    {
+      const std::string& w = words[i * 2 + j];
+      if (std::from_chars(w.data(), w.data() + w.size(), word[j]).ec != std::errc())
+      {
+        CLog::LogF(LOGERROR, "unexpected curve in {}", HVS_PQ_CURVE);
+        return {};
+      }
+    }
+    points[i] = {static_cast<float>(word[0] >> 20), (word[0] & 0xffff) / 16.0f,
+                 (word[1] & 0xfff) / 256.0f};
+  }
+
+  // as evaluated by the hardware on 12 bit values
+  auto curve = [&points](float x)
+  {
+    int i = HVS_PQ_CURVE_POINTS - 1;
+    while (i > 0 && x < points[i].x)
+      i--;
+    return std::clamp(points[i].c + (x - points[i].x) * points[i].grad, 0.0f, 4095.0f);
+  };
+
+  std::vector<float> inverse(size);
+  for (int i = 0; i < size; i++)
+  {
+    const float target = 4095.0f * i / (size - 1);
+    float low = 0.0f;
+    float high = 4095.0f;
+    for (int n = 0; n < 24; n++)
+    {
+      const float mid = (low + high) / 2;
+      if (curve(mid) < target)
+        low = mid;
+      else
+        high = mid;
+    }
+    inverse[i] = high / 4095.0f;
+  }
+
+  return inverse;
+}
