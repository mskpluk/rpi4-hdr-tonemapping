@@ -264,6 +264,12 @@ void CRendererDRMPRIME::RenderUpdate(
     winSystem->RegisterVideoLayerBridge(m_videoLayerBridge);
   }
 
+  if (m_toneMappingAllowed != (m_videoSettings.m_ToneMapMethod != VS_TONEMAPMETHOD_OFF))
+  {
+    m_toneMappingAllowed = !m_toneMappingAllowed;
+    UpdateToneMapping();
+  }
+
   if (m_iLastRenderBuffer == -1)
     m_videoLayerBridge->Configure(buffer);
 
@@ -289,6 +295,10 @@ bool CRendererDRMPRIME::Supports(ERENDERFEATURE feature) const
     case RENDERFEATURE_VERTICAL_SHIFT:
     case RENDERFEATURE_PIXEL_RATIO:
       return true;
+    case RENDERFEATURE_TONEMAP:
+    case RENDERFEATURE_TONEMAP_HW:
+      return static_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem())
+          ->SupportsHwToneMapping();
     default:
       return false;
   }
@@ -301,7 +311,7 @@ bool CRendererDRMPRIME::Supports(ESCALINGMETHOD method) const
 
 void CRendererDRMPRIME::UpdateToneMapping()
 {
-  const bool enable = m_pqWithoutHdr;
+  const bool enable = m_pqWithoutHdr && m_toneMappingAllowed;
   if (enable == m_hwToneMapping)
     return;
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.h b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.h
index 5170dfe..291ef6c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.h
@@ -54,6 +54,7 @@ private:
   bool m_bConfigured = false;
   int m_iLastRenderBuffer = -1;
   bool m_pqWithoutHdr = false;
+  bool m_toneMappingAllowed = false;
   bool m_hwToneMapping = false;
   CRect m_planeDestRect;
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGL.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGL.cpp
