From 23ad442a50fb032d985a223f2d4f4ab4e886fab4 Mon Sep 17 00:00:00 2001
From: Marcin <91057909+mskpluk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:31:37 +0000
Subject: [PATCH] [GBM] Composite the GUI through the inverse Raspberry Pi 4
 HVS curve

The HVS gamma block works on the composited output, so the curve also
maps the GUI and brightens its mid tones. Read the curve from
hvs5_pq_pwl, invert it into the LUT of the GLES GUI composite shader and
composite the GUI through it while the curve is on, so menus, OSD and
text subtitles look as in SDR. If that is not possible, the curve stays
off.
---
 .../shaders/GLES/2.0/gles_gui_composite.frag  | 16 +++++
 .../HwDecRender/RendererDRMPRIME.cpp          | 31 +++++---
 .../HwDecRender/RendererDRMPRIME.h            |  1 +
 .../rendering/gles/GuiCompositeShaderGLES.cpp | 30 ++++++++
 xbmc/rendering/gles/GuiCompositeShaderGLES.h  | 10 ++-
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 72 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.h             |  6 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  7 +-
 8 files changed, 160 insertions(+), 13 deletions(-)

diff --git a/system/shaders/GLES/2.0/gles_gui_composite.frag b/system/shaders/GLES/2.0/gles_gui_composite.frag
index 4cfd4fd..2076418 100644
--- a/system/shaders/GLES/2.0/gles_gui_composite.frag
+++ b/system/shaders/GLES/2.0/gles_gui_composite.frag
@@ -15,6 +15,8 @@ uniform sampler2D u_lutDegamma; // sRGB -> linear LUT (IEC 61966-2-1)
 uniform sampler2D u_lutTF;      // linear -> PQ LUT (1024 entries, sdrPeak baked in)
 uniform float u_ootfGamma;      // HLG: OOTF gamma (1.2 for BT.2100 1000-nit ref)
                                 // PQ: 0.0 (use LUT path instead)
+uniform float u_hvsCurve;       // 1.0: u_lutTF is the inverse of the Raspberry Pi 4
+                                // HVS curve applied after the planes are blended
 
 // BT.709 -> BT.2020 color space conversion matrix (applied in linear light)
 const mat3 bt709_to_bt2020 = mat3(
@@ -33,6 +35,20 @@ void main()
   if (gui.a == 0.0)
     discard;
 
+  if (u_hvsCurve > 0.0)
+  {
+    // The GUI stays SDR, only the curve the display hardware applies is undone.
+    vec3 sdr = gui.rgb;
+#ifdef KODI_LIMITED_RANGE
+    sdr = sdr * ((235.0 - 16.0) / 255.0) + (16.0 / 255.0);
+#endif
+    gl_FragColor = vec4(texture2D(u_lutTF, vec2(sdr.r, 0.5)).r,
+                        texture2D(u_lutTF, vec2(sdr.g, 0.5)).r,
+                        texture2D(u_lutTF, vec2(sdr.b, 0.5)).r,
+                        gui.a);
+    return;
+  }
+
   // sRGB -> linear via LUT (IEC 61966-2-1 EOTF, replaces inline pow)
   vec3 linear = vec3(
     texture2D(u_lutDegamma, vec2(gui.r, 0.5)).r,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.cpp
index 792c1b5..83e3e87 100644
