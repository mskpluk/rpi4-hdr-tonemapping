From 40f1d9aa4cfca2a2aa4d759e9990733c84ac3002 Mon Sep 17 00:00:00 2001
From: Marcin <91057909+mskpluk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:21:52 +0000
Subject: [PATCH] [DRMPRIME] Add the hardware BT.2390 tone mapping setting

Offer BT.2390 as the tone mapping method when the hardware curve is
available. It is then the only method besides Off, without the parameter
slider, and the tone mapping action switches between the two. Shader
renderers have no BT.2390, so they treat a saved BT.2390 as Hable.
---
 .../resources/strings.po                      |  5 ++-
 xbmc/application/Application.cpp              | 17 ++++++++--
 xbmc/cores/IPlayer.h                          |  3 +-
 .../HwDecRender/RendererDRMPRIME.cpp          | 12 ++++++-
 .../HwDecRender/RendererDRMPRIME.h            |  1 +
 .../VideoRenderers/LinuxRendererGL.cpp        |  4 +--
 .../VideoRenderers/LinuxRendererGLES.cpp      |  4 +--
 .../VideoRenderers/windows/RendererBase.cpp   |  2 +-
 xbmc/cores/VideoSettings.h                    |  8 +++++
 xbmc/video/dialogs/GUIDialogVideoSettings.cpp | 32 +++++++++++++------
 10 files changed, 68 insertions(+), 20 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 58ddc85..c218a6e 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -22711,7 +22711,10 @@ msgctxt "#36558"
 msgid "Hable"
 msgstr ""
 
-#empty string with id 36559
+#: xbmc/video/dialogs/GUIDialogVideoSettings.cpp
+msgctxt "#36559"
+msgid "BT.2390"
+msgstr ""
 
 #: system/settings/settings.xml
 msgctxt "#36560"
diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 531130c..5cd3b5e 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1089,10 +1089,18 @@ bool CApplication::OnAction(const CAction &action)
     if (appPlayer->IsPlayingVideo())
     {
       CVideoSettings vs = appPlayer->GetVideoSettings();
-      vs.m_ToneMapMethod = static_cast<ETONEMAPMETHOD>(static_cast<int>(vs.m_ToneMapMethod) + 1);
-      if (vs.m_ToneMapMethod >= VS_TONEMAPMETHOD_MAX)
+      if (appPlayer->Supports(RENDERFEATURE_TONEMAP_HW))
+      {
+        vs.m_ToneMapMethod = VS_TONEMAPMETHOD_BT2390;
+      }
+      else
+      {
         vs.m_ToneMapMethod =
-            static_cast<ETONEMAPMETHOD>(static_cast<int>(VS_TONEMAPMETHOD_OFF) + 1);
+            static_cast<ETONEMAPMETHOD>(static_cast<int>(vs.m_ToneMapMethod) + 1);
+        if (vs.m_ToneMapMethod >= VS_TONEMAPMETHOD_BT2390)
+          vs.m_ToneMapMethod =
+              static_cast<ETONEMAPMETHOD>(static_cast<int>(VS_TONEMAPMETHOD_OFF) + 1);
+      }
 
       appPlayer->SetVideoSettings(vs);
 
@@ -1108,6 +1116,9 @@ bool CApplication::OnAction(const CAction &action)
         case VS_TONEMAPMETHOD_HABLE:
           code = 36558;
           break;
+        case VS_TONEMAPMETHOD_BT2390:
+          code = 36559;
+          break;
         default:
           throw std::logic_error("Tonemapping method not found. Did you forget to add a mapping?");
       }
diff --git a/xbmc/cores/IPlayer.h b/xbmc/cores/IPlayer.h
index 5f96bc3..b99bf60 100644
--- a/xbmc/cores/IPlayer.h
+++ b/xbmc/cores/IPlayer.h
@@ -82,7 +82,8 @@ enum ERENDERFEATURE
   RENDERFEATURE_VERTICAL_SHIFT,
   RENDERFEATURE_PIXEL_RATIO,
   RENDERFEATURE_POSTPROCESS,
-  RENDERFEATURE_TONEMAP
+  RENDERFEATURE_TONEMAP,
+  RENDERFEATURE_TONEMAP_HW // fixed BT.2390 curve in the display hardware
 };
 
 class IPlayer
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.cpp
index ee64ed2..cb124fa 100644
